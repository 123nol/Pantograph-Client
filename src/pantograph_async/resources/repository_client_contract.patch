     s!".failure {messages}"
   | .parseError error => s!".parseError {error}"
diff --git a/Test/CompilerDiagnostic.lean b/Test/CompilerDiagnostic.lean
new file mode 100644
index 0000000..9ae4b65
--- /dev/null
+++ b/Test/CompilerDiagnostic.lean
@@ -0,0 +1,102 @@
+import Pantograph
+
+open Lean Pantograph
+
+/-! Provenance of the environment entries that compiler-producing tactics add.
+
+This walk is diagnostic evidence for the classifier, not the production audit. -/
+
+private def kindOf : ConstantInfo → String
+  | .axiomInfo _ => "axiom" | .defnInfo _ => "definition" | .thmInfo _ => "theorem"
+  | .opaqueInfo _ => "opaque" | .quotInfo _ => "quotient" | .inductInfo _ => "inductive"
+  | .ctorInfo _ => "constructor" | .recInfo _ => "recursor"
+
+private def safetyOf : ConstantInfo → String
+  | .defnInfo v => match v.safety with | .safe => "safe" | .unsafe => "unsafe" | .partial => "partial"
+  | info => if info.isUnsafe then "unsafe" else "safe"
+
+private def describe (env : Environment) (trusted : Environment) (name : Name) (info : ConstantInfo) : Json :=
+  let used := info.type.getUsedConstants ++ (info.value?.map Expr.getUsedConstants |>.getD #[])
+  let used := used.toList.eraseDups
+  let unresolved := used.filter fun n => !env.contains n
+  Json.mkObj [
+    ("name", toJson name.toString), ("kind", kindOf info), ("safety", safetyOf info),
+    ("levelParams", toJson (info.levelParams.map toString)),
+    ("hasIR", toJson (IR.findEnvDecl env name).isSome),
+    ("prefix", toJson name.getPrefix.toString),
+    ("prefixHasIR", toJson (IR.findEnvDecl env name.getPrefix).isSome),
+    ("prefixIsConstant", toJson (env.contains name.getPrefix)),
+    ("prefixTrusted", toJson (trusted.contains name.getPrefix)),
+    ("typeHasFVar", toJson info.type.hasFVar), ("typeHasMVar", toJson info.type.hasMVar),
+    ("valueHasFVar", toJson (info.value?.any Expr.hasFVar)), ("valueHasMVar", toJson (info.value?.any Expr.hasMVar)),
+    ("unresolved", toJson (unresolved.map toString)),
+    ("unresolvedWithIR", toJson ((unresolved.filter fun n => (IR.findEnvDecl env n).isSome).map toString)),
+    ("type", toJson ((toString info.type).take 300))]
+
+private def run (expr : String) (tactics : List String) : CoreM Json := do
+  let .ok root ← goalStartExpr expr #[] | throwError "start failed"
+  let mut state := root
+  let mut outcomes := #[]
+  for tactic in tactics do
+    match ← runTermElabM (state.tryTactic state.goals.head! tactic) with
+    | .success next => state := next; outcomes := outcomes.push (toJson s!"{tactic}: success")
+    | _ => outcomes := outcomes.push (toJson s!"{tactic}: not a success"); break
+  let env := state.env
+  let trusted := root.trustedEnv
+  let additions := env.constants.foldStage2 (fun acc name info =>
+    if trusted.contains name then acc else (name, info) :: acc) []
+  let extra := env.extraConstNames.toList.filter fun n => !trusted.contains n
+  let checked ← validateSnapshot state
+  return Json.mkObj [
+    ("goal", toJson expr), ("tactics", toJson outcomes),
+    ("additions", toJson ((additions.reverse.map fun (n, i) => describe env trusted n i).toArray)),
+    ("extraConstNames", toJson (extra.map toString)),
+    ("extraWithIR", toJson ((extra.filter fun n => (IR.findEnvDecl env n).isSome).map toString)),
+    ("validator", match checked with | .ok _ => "accepted" | .error message => toJson message)]
+
+/-- Every imported compiler stage entry, built by the same pinned compiler: which references
+    are neither constants nor IR declarations, and which shapes occur. -/
+private def inventory : CoreM Json := do
+  let env ← getEnv
+  let mut sentinels : HashMap String Nat := {}
+  let mut shapes : HashMap String Nat := {}
+  let mut count := 0
+  let mut withFVars : Array Json := #[]
+  for (name, info) in env.constants.toList do
+    let .str owner stage := name | continue
+    unless stage == "_cstage1" || stage == "_cstage2" do continue
+    count := count + 1
+    let shape := s!"{stage} {kindOf info} {safetyOf info} ownerIR={(IR.findEnvDecl env owner).isSome} ownerConst={env.contains owner} levels={!info.levelParams.isEmpty} looseBVars={info.type.hasLooseBVars || info.value?.any Expr.hasLooseBVars} fvar={info.type.hasFVar || info.value?.any Expr.hasFVar} mvar={info.type.hasMVar || info.value?.any Expr.hasMVar}"
+    shapes := shapes.insert shape (shapes.findD shape 0 + 1)
+    if (info.type.hasFVar || info.value?.any Expr.hasFVar) && withFVars.size < 16 then
+      let fvars := (Lean.collectFVars {} info.type).fvarIds ++ (info.value?.map (Lean.collectFVars {} · |>.fvarIds) |>.getD #[])
+      withFVars := withFVars.push <| Json.mkObj [("name", toJson name.toString),
+        ("module", toJson ((env.getModuleIdxFor? name).bind (env.header.moduleNames.get? ·.toNat) |>.map toString)),
+        ("fvars", toJson (fvars.map (·.name.toString)))]
+    let used := info.type.getUsedConstants ++ (info.value?.map Expr.getUsedConstants |>.getD #[])
+    for n in used do
+      unless env.contains n || (IR.findEnvDecl env n).isSome do
+        let key := s!"{stage} {n}"
+        sentinels := sentinels.insert key (sentinels.findD key 0 + 1)
+  return Json.mkObj [("entries", toJson count), ("withFreeVariables", toJson withFVars),
+    ("shapes", toJson (shapes.toList.map fun (k, v) => s!"{v} × {k}")),
+    ("unresolved", toJson (sentinels.toList.map fun (k, v) => s!"{v} × {k}"))]
+
+unsafe def main (args : List String) : IO Unit := do
+  Pantograph.initSearch ""
+  let ctx ← createCoreContext #[]
+  let inventoryMode := args.head? == some "--inventory"
+  let args := if inventoryMode then args.tail! else args
+  let imports := if args.isEmpty then #["Init"] else args.toArray
+  let state ← createCoreState imports
+  if inventoryMode then
+    let (result, _) ← inventory.toIO ctx state
+    IO.println result.pretty
+    return
+  let cases := [
+    ("∀ m n : Nat, Nat.pow m (n+1) = Nat.pow m n * m", ["intro m n", "unfold Nat.pow"]),
+    ("∀ l : List Nat, List.length (0 :: l) = l.length + 1", ["intro l", "simp only [List.length]"]),
+    ("∀ n : Nat, Nat.pred (n+1) = n", ["intro n", "unfold Nat.pred"])]
+  for (expr, tactics) in cases do
+    let (result, _) ← (run expr tactics).toIO ctx state
+    IO.println result.pretty
diff --git a/Test/CompilerValidation.lean b/Test/CompilerValidation.lean
new file mode 100644
index 0000000..75334a9
--- /dev/null
+++ b/Test/CompilerValidation.lean
@@ -0,0 +1,148 @@
+import Test.Common
+import Pantograph.DeclarationAudit
+import Pantograph.Validation
+import Pantograph.Certify
+
+/-! Compiler-producing tactics and the representation-aware audit.
+
+`unfold Nat.pow` generates the match splitter for `Nat.pow.match_1`, which is
+compiled on demand; the code generator then stores its stage entries
+(`_private.0.Nat.pow.match_1.splitter._cstage1`, `…splitter._cstage2`,
+`…splitter._rarg._cstage2`) in the retained environment. -/
+
+namespace Pantograph.Test.CompilerValidation
+open Lean
+
+private def withEnv (state : GoalState) (env : Environment) : GoalState :=
+  { state with savedState := { state.savedState with term := { state.savedState.term with
+    meta := { state.savedState.term.meta with core := { state.savedState.term.meta.core with env } } } } }
+
+private def withMCtx (state : GoalState) (mctx : MetavarContext) : GoalState :=
+  { state with savedState := { state.savedState with term := { state.savedState.term with
+    meta := { state.savedState.term.meta with meta := { state.metaState with mctx } } } } }
+
+private def rejects (result : Except String CheckedTransition) : Bool := result.toOption.isNone
+
+private def rejectsWith (fragment : String) (result : Except String CheckedTransition) : Bool :=
+  match result with
+  | .error message => (message.splitOn fragment).length > 1
+  | .ok _ => false
+
+/-- Add a declaration as the code generator does: without a kernel check. -/
+private def addUnchecked (state : GoalState) (decl : Declaration) : Elab.TermElabM GoalState := do
+  match state.env.addDeclWithoutChecking decl with
+  | .ok env => return withEnv state env
+  | .error _ => throwError "unchecked addition failed"
+
+private def unsafeDefinition (name : Name) (type value : Expr) : Declaration :=
+  .defnDecl { name, levelParams := [], type, value, hints := .opaque, safety := .unsafe, all := [name] }
+
+private def safeDefinition (name : Name) (type value : Expr) : Declaration :=
+  .defnDecl { name, levelParams := [], type, value, hints := .opaque, safety := .safe, all := [name] }
+
+private def additions (state : GoalState) : List Name :=
+  state.env.constants.foldStage2 (fun acc name _ => if state.trustedEnv.contains name then acc else name :: acc) []
+
+private def tactic (state : GoalState) (text : String) (goal? : Option MVarId := none) :
+    Elab.TermElabM (GoalState × Except String CheckedTransition) := do
+  let some goal := goal?.orElse fun _ => state.goals.head? | throwError s!"{text}: no goal"
+  -- The REPL runs each tactic in a fresh elaboration context over the saved state.
+  let .success next ← (runTermElabM (state.tryTactic goal text) : CoreM _) | throwError s!"{text} failed"
+  return (next, ← validateTransition state next goal)
+
+private def splitter : Name := Name.mkNum `_private 0 ++ `Nat.pow.match_1.splitter
+
+private def tests : Elab.TermElabM LSpec.TestSeq := do
+  let mut tests := LSpec.TestSeq.done
+  let .ok root ← goalStartExpr "∀ m n : Nat, Nat.pow m n = Nat.pow m n" #[] | throwError "start failed"
+  let (intro, checked) ← tactic root "intro m n"
+  let some intro := checked.toOption.map (·.state) | throwError "intro rejected"
+  let (unfolded, checked) ← tactic intro "unfold Nat.pow"
+  let compiled := (additions unfolded).filter fun name =>
+    isCompilerRepresentation unfolded.env unfolded.trustedEnv name
+  tests := tests ++ LSpec.test "the unfold leaves fresh compiler stage entries in the environment"
+    (compiled.length == 3 && compiled.contains (splitter.str "_cstage2") && compiled.contains ((splitter.str "_rarg").str "_cstage2"))
+  tests := tests ++ LSpec.test "a compiler-producing transition is accepted without hazards"
+    (checked.toOption.any fun c => !c.hasSorry && !c.hasUnsafe && c.state.goals.length == 1)
+  let some unfolded := checked.toOption.map (·.state) | throwError "unfold rejected"
+  tests := tests ++ LSpec.test "the splitter itself is a kernel declaration"
+    (classifyName unfolded.env unfolded.trustedEnv splitter == some .kernel)
+  tests := tests ++ LSpec.test "inspection of the retained output validates"
+    ((← validateSnapshot unfolded unfolded.goals).toOption.isSome)
+  let (split, checked) ← tactic unfolded "split"
+  tests := tests ++ LSpec.test "a later tactic continues the compiler-producing state"
+    (checked.toOption.any (·.state.goals.length == 2))
+  let some split := checked.toOption.map (·.state) | throwError "split rejected"
+  let [_, sibling] := split.goals | throwError "split goals"
+  let (_, checked) ← tactic split "rfl"
+  let some first := checked.toOption.map (·.state) | throwError "first rfl rejected"
+  -- The REPL resumes the dormant sibling; here it is selected explicitly.
+  let (_, checked) ← tactic first "rfl" sibling
+  let some done := checked.toOption.map (·.state) | throwError "second rfl rejected"
+  let certificate ← certifyRoot done 200000
+  let auxiliary := certificate.receipt?.map (·.auxiliary) |>.getD #[]
+  tests := tests ++ LSpec.test "the original root certifies with kernel auxiliaries only"
+    (certificate.status == "certified" && auxiliary.contains splitter.toString &&
+      auxiliary.all fun name => (name.splitOn "_cstage").length == 1)
+
+  -- A compiler entry is runtime data, never a proof dependency.
+  let stage2 := splitter.str "_cstage2"
+  let leaked := withMCtx done { done.mctx with eAssignment := done.mctx.eAssignment.insert done.root (mkConst stage2) }
+  tests := tests ++ LSpec.test "the root proof cannot reference a compiler entry"
+    (rejectsWith "Compiler-only declaration" (← validateSnapshot leaked))
+  tests := tests ++ LSpec.test "certification rejects a compiler entry in the proof"
+    ((← certifyRoot leaked 200000).status == "rejected")
+  let user ← addUnchecked done (safeDefinition `Uses.compiler (mkConst ``Nat) (mkConst stage2))
+  tests := tests ++ LSpec.test "a kernel declaration cannot reach compiler data after it was audited"
+    (rejectsWith "Compiler-only declaration" (← validateSnapshot user))
+
+  -- The exemption needs the compiler's registration, not the spelling.
+  let named ← addUnchecked done (unsafeDefinition `Fake._cstage2 (mkConst `_obj) (mkConst `_neutral))
+  tests := tests ++ LSpec.test "a stage-named entry without compiler IR keeps the kernel audit"
+    (classifyName named.env named.trustedEnv `Fake._cstage2 == some .kernel &&
+      rejectsWith "Missing proof dependency _obj" (← validateSnapshot named))
+  let ordinary ← addUnchecked done (safeDefinition `Ordinary._cstage2 (mkConst ``Nat) (mkNatLit 0))
+  tests := tests ++ LSpec.test "a well-formed kernel declaration named like a stage is checked, not exempted"
+    (classifyName ordinary.env ordinary.trustedEnv `Ordinary._cstage2 == some .kernel &&
+      (← validateSnapshot ordinary).toOption.isSome)
+  let sentinel := withMCtx intro { intro.mctx with eAssignment := intro.mctx.eAssignment.insert intro.goals.head! (mkConst `_obj) }
+  tests := tests ++ LSpec.test "a compiler sentinel in an ordinary kernel expression rejects"
+    (rejectsWith "Missing proof dependency _obj" (← validateSnapshot sentinel))
+
+  -- Registered compiler data still has to be well formed.
+  let boxed := (splitter.str "_rarg").str "_boxed"
+  let malformed ← addUnchecked done (unsafeDefinition (boxed.str "_cstage2") (mkConst `_obj) (mkConst `Missing.runtime))
+  tests := tests ++ LSpec.test "registered compiler data with an unresolved reference is an integrity failure"
+    (classifyName malformed.env malformed.trustedEnv (boxed.str "_cstage2") == some (.compiler 2 boxed) &&
+      rejectsWith "unresolved compiler reference Missing.runtime" (← validateSnapshot malformed))
+  let open_ ← addUnchecked done (unsafeDefinition (boxed.str "_cstage2") (mkConst `_obj) (.bvar 0))
+  tests := tests ++ LSpec.test "registered compiler data must be closed"
+    (rejectsWith "loose bound variable" (← validateSnapshot open_))
+  tests := tests ++ LSpec.test "stage-1 representations cannot use stage-2 sentinels"
+    (compilerEntryProblems done.env 1 (.defnInfo { name := `x, levelParams := [], type := mkConst `_obj, value := mkConst ``Nat, hints := .opaque, safety := .unsafe, all := [] }) != #[])
+
+  -- Hazard accounting is unchanged for proof dependencies.
+  let admission := mkApp2 (mkConst ``sorryAx [.zero]) done.rootType (mkConst ``Bool.false)
+  let admitted := withMCtx done { done.mctx with eAssignment := done.mctx.eAssignment.insert done.root admission }
+  tests := tests ++ LSpec.test "an admission in a compiler-producing proof is still reported"
+    ((← validateSnapshot admitted).toOption.any (·.hasSorry) &&
+      (← certifyRoot admitted 200000).status == "rejected")
+  return tests
+
+/-- The same transition on a session that has already run an unrelated tactic. -/
+private def warmed : Elab.TermElabM LSpec.TestSeq := do
+  let .ok warm ← goalStartExpr "True ∧ True" #[] | throwError "warm start failed"
+  let .success _ ← warm.tryTactic warm.root "simp" | throwError "warm simp failed"
+  let .ok root ← goalStartExpr "∀ m n : Nat, Nat.pow m (n+1) = Nat.pow m n * m" #[] | throwError "start failed"
+  let (_, checked) ← tactic root "intro m n"
+  let some intro := checked.toOption.map (·.state) | throwError "intro rejected"
+  let (_, checked) ← tactic intro "rw [Nat.pow]"
+  return LSpec.test "a rewrite with generated equations is accepted after earlier history"
+    (checked.toOption.any fun c => !c.hasUnsafe && c.state.goals.length == 1)
+
+def suite (env : Environment) : List (String × IO LSpec.TestSeq) := [
+  ("Compiler-producing transitions", runTermElabMSeq env tests),
+  ("Warmed session history", runTermElabMSeq env warmed)
+]
+
+end Pantograph.Test.CompilerValidation
diff --git a/Test/ContractFixtures.lean b/Test/ContractFixtures.lean
new file mode 100644
index 0000000..5590585
--- /dev/null
+++ b/Test/ContractFixtures.lean
@@ -0,0 +1,149 @@
+import Pantograph
+
+open Lean Elab Tactic
+
+/-- Test-only operation that reaches the unsafe scanner with an elaborated assignment. -/
+elab "contract_unsafe" : tactic => do
+  let name := `ContractFixtures.unsafeProof
+  let info : DefinitionVal := {
+    name, levelParams := [], type := mkConst ``True,
+    value := mkConst ``True.intro, hints := .opaque, safety := .unsafe
+  }
+  addDecl (.defnDecl info)
+  (← getMainGoal).assign (mkConst name)
+  setGoals []
+
+/-- A new safe dependency whose value contains an admission. -/
+elab "contract_dependency_sorry" : tactic => do
+  let value ← Meta.mkSorry (mkConst ``True) false
+  let name := `ContractFixtures.admittedProof
+  let info : DefinitionVal := {
+    name, levelParams := [], type := mkConst ``True,
+    value, hints := .opaque, safety := .safe
+  }
+  addDecl (.defnDecl info)
+  (← getMainGoal).assign (mkConst name)
+  setGoals []
+
+/-- Deliberately remove a reachable proof hole from the visible list. -/
+elab "contract_hidden_hole" : tactic => do
+  let goal ← getMainGoal
+  let hole ← Meta.mkFreshExprSyntheticOpaqueMVar (← goal.getType)
+  goal.assign hole
+  setGoals []
+
+/-- Mutate the environment and close the goal before reporting a logged error. -/
+elab "contract_failed_mutation" : tactic => do
+  let info : DefinitionVal := {
+    name := `ContractFixtures.failedMutation, levelParams := [], type := mkConst ``True,
+    value := mkConst ``True.intro, hints := .opaque, safety := .safe
+  }
+  addDecl (.defnDecl info)
+  (← getMainGoal).assign (mkConst ``True.intro)
+  setGoals []
+  discard <| Meta.inferType (mkConst `ContractFixtures.failedMutation)
+  logError "mutation must roll back"
+
+/-- Keep a newly introduced declaration in a partial state for a later tactic. -/
+elab "contract_store_admission" : tactic => do
+  let value ← Meta.mkSorry (mkConst ``True) false
+  addDecl (.defnDecl {
+    name := `ContractFixtures.storedAdmission, levelParams := [], type := mkConst ``True,
+    value, hints := .opaque, safety := .safe
+  })
+
+/-- A tagged diagnostic verifies that the wire kind comes from the message data. -/
+elab "contract_tagged_warning" : tactic => do
+  logWarning (.tagged `ContractFixtures.warningKind m!"tagged warning")
+
+/-- Reuse a failed declaration's name with a different type to test cache rollback. -/
+elab "contract_reuse_failed_name" : tactic => do
+  let name := `ContractFixtures.failedMutation
+  addDecl (.defnDecl {
+    name, levelParams := [], type := mkConst ``Nat,
+    value := mkNatLit 0, hints := .opaque, safety := .safe
+  })
+  unless (← Meta.inferType (mkConst name)).isConstOf ``Nat do
+    throwError "failed declaration type cache leaked"
+  (← getMainGoal).assign (mkConst name)
+  setGoals []
+
+/-- A delayed assignment whose pending proof was omitted from the goal list. -/
+elab "contract_delayed_hole" : tactic => do
+  let goal ← getMainGoal
+  let pending ← Meta.mkFreshExprSyntheticOpaqueMVar (← goal.getType)
+  assignDelayedMVar goal #[] pending.mvarId!
+  setGoals []
+
+/-- Missing assignment declarations must produce a named validation error. -/
+elab "contract_missing_assignment" : tactic => do
+  (← getMainGoal).assign (.mvar ⟨`ContractFixtures.missingAssignment⟩)
+  setGoals []
+
+/-- A reachable unresolved let value must survive a closed visible goal list. -/
+elab "contract_hidden_local_value" : tactic => withMainContext do
+  let goal ← getMainGoal
+  let hole ← Meta.mkFreshExprSyntheticOpaqueMVar (mkConst ``True)
+  Meta.withLetDecl `hiddenValue (mkConst ``True) hole fun value => do
+    goal.assign (← Meta.mkLetFVars #[value] value)
+  setGoals []
+
+/-- Close the goal with an axiom added during the search. -/
+elab "contract_new_axiom" : tactic => do
+  let goal ← getMainGoal
+  let name := `ContractFixtures.searchAxiom
+  addDecl (.axiomDecl { name, levelParams := [], type := ← instantiateMVars (← goal.getType), isUnsafe := false })
+  goal.assign (mkConst name)
+  setGoals []
+
+/-- Close the goal with a checked auxiliary lemma added during the search. -/
+elab "contract_auxiliary_lemma" : tactic => do
+  let goal ← getMainGoal
+  let name := `ContractFixtures.auxiliaryLemma
+  addDecl (.thmDecl { name, levelParams := [], type := mkConst ``True, value := mkConst ``True.intro })
+  goal.assign (mkConst name)
+  setGoals []
+
+/-- Exercise Lean's native reduction heartbeat checks without completing the proof. -/
+elab "contract_heartbeat" : tactic => do
+  let mut expr := mkNatLit 0
+  for _ in [:1000000] do
+    expr := mkApp (mkConst ``Nat.succ) expr
+    discard <| Meta.whnf expr
+
+/-- Exercise a fatal exception at the executable transaction boundary. -/
+elab "contract_internal_failure" : tactic => do
+  throw <| Exception.internal Pantograph.commandResourceExceptionId
+
+/-- An error whose message cannot be rendered: the tactic's own error handler fails. -/
+elab "contract_unrenderable_error" : tactic => do
+  throwError (MessageData.ofLazy (fun _ => throw (IO.userError "contract render failure"))
+    (fun _ => false))
+
+/-- Spend allocations while a lazy diagnostic is rendered, after tactic execution. -/
+elab "contract_diagnostic_heartbeat" : tactic => do
+  let data := MessageData.ofLazy (fun _ => do
+    let values ← IO.mkRef (#[] : Array Nat)
+    for index in [:1000000] do
+      values.modify (·.push index)
+    return Dynamic.mk ("rendered" : MessageData)) (fun _ => false)
+  logInfo data
+
+unsafe def ContractFixtures.unusedUnsafe : Nat := 0
+
+/-- Elaboration residue whose owner no longer contains a discarded local. -/
+elab "contract_inert_residue" : tactic => do
+  let scratch ← Meta.mkFreshExprSyntheticOpaqueMVar (mkSort .zero)
+  let discarded ← mkFreshFVarId
+  scratch.mvarId!.assign (.fvar discarded)
+  (← getMainGoal).assign (mkConst ``True.intro)
+  setGoals []
+
+/-- An integrity failure after a native command-visible environment mutation. -/
+elab "contract_invalid_mutation" : tactic => do
+  let name := `ContractFixtures.invalidMutation
+  addDecl (.defnDecl {
+    name, levelParams := [], type := mkConst ``True,
+    value := mkConst ``True.intro, hints := .opaque, safety := .safe })
+  (← getMainGoal).assign (.fvar (← mkFreshFVarId))
+  setGoals []
diff --git a/Test/FailureBoundary.lean b/Test/FailureBoundary.lean
new file mode 100644
index 0000000..ac6494e
--- /dev/null
+++ b/Test/FailureBoundary.lean
@@ -0,0 +1,60 @@
+import Test.Common
+import Pantograph.Validation
+import Pantograph.Certify
+import Repl
+
+/-! Elaboration aborts are ordinary tactic failures; unexpected failures keep evidence.
+
+`exact`, `refine` and `have` log "don't know how to synthesize placeholder" and then
+throw Lean's internal abort exception. The REPL used to treat every internal
+exception as an unexpected failure and end the session. -/
+
+namespace Pantograph.Test.FailureBoundary
+open Lean
+
+private def failsWith (fragment : String) : TacticResult → Bool
+  | .failure errors _ => errors.any fun e => (e.splitOn fragment).length > 1
+  | _ => false
+
+private def placeholderTactics : List String := [
+  "exact (fun (x : Nat) => True.intro) _",
+  "refine (fun (x : Nat) => True.intro) _",
+  "have h := (fun (x : Nat) => x) _",
+  "exact (_ : True)"]
+
+private def abortTests : Elab.TermElabM LSpec.TestSeq := do
+  let mut tests := LSpec.TestSeq.done
+  let .ok root ← goalStartExpr "True" #[] | throwError "start failed"
+  for tactic in placeholderTactics do
+    let result ← (runTermElabM (root.tryTactic root.root tactic) : CoreM _)
+    tests := tests ++ LSpec.test s!"{tactic} is an ordinary failure with Lean's own message"
+      (failsWith "don't know how to synthesize placeholder" result)
+  -- The rejected candidate leaves the input state usable for the next one.
+  let .success done ← (runTermElabM (root.tryTactic root.root "trivial") : CoreM _) | throwError "trivial failed"
+  tests := tests ++ LSpec.test "the input state still proves the goal after the failures"
+    ((← validateTransition root done root.root).toOption.isSome &&
+      (← certifyRoot done 200000).status == "certified")
+  return tests
+
+private def boundTests : LSpec.TestSeq :=
+  let huge := String.join (List.replicate 4000 "∀\"\\\n")
+  let evidence : Repl.FailureEvidence := { sequence := 7, operation := "goal.tactic", stateId := some 3, goalIndex := some 0, phase := "observe", category := "error", detail := some huge }
+  let line := evidence.line
+  let parsed := Json.parse line
+  let field (key : String) := parsed.toOption.bind fun j => (j.getObjVal? key).toOption
+  let unrendered : Repl.FailureEvidence := { sequence := 1, operation := "goal.certify", category := "internal", internalId := some "x", detail := none }
+  let failed := unrendered.line
+  LSpec.test "a huge escaped detail is cut so the whole line stays within the byte limit"
+      (line.utf8ByteSize ≤ Repl.diagnosticLineBytes && parsed.toOption.isSome) ++
+    LSpec.test "the record says the detail was truncated"
+      (field "detail_truncated" == some (Json.bool true) && field "kind" == some (Json.str "pantograph-command-failure")) ++
+    LSpec.test "a failed rendering is reported, not invented"
+      ((Json.parse failed).toOption.any fun j =>
+        (j.getObjVal? "render_status").toOption == some (Json.str "failed") && (j.getObjVal? "detail").toOption == some Json.null)
+
+def suite (env : Environment) : List (String × IO LSpec.TestSeq) := [
+  ("Elaboration aborts", runTermElabMSeq env abortTests),
+  ("Diagnostic bounds", pure boundTests)
+]
+
+end Pantograph.Test.FailureBoundary
