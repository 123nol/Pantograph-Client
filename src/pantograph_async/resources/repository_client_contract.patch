diff --git a/Test/Transaction.lean b/Test/Transaction.lean
new file mode 100644
index 0000000..50bf197
--- /dev/null
+++ b/Test/Transaction.lean
@@ -0,0 +1,108 @@
+import Test.Common
+import Test.ContractFixtures
+import Repl
+
+namespace Pantograph.Test.Transaction
+open Lean Pantograph.Repl
+
+private def command (cmd : String) (fields : List (String × Json) := []) : Protocol.Command :=
+  { cmd, payload := Json.mkObj fields }
+
+private def field (response : Json) (key : String) : String :=
+  response.getObjValAs? String key |>.toOption |>.getD ""
+
+private def burn : CoreM Unit := do
+  for _ in [:1000000] do
+    discard <| Meta.whnf (mkApp (mkConst ``Nat.succ) (mkNatLit 0)) |>.run'
+
+private def tests : MainM LSpec.TestSeq := do
+  let mut tests := LSpec.TestSeq.done
+  let start ← execute (command "goal.start" [("expr", .str "True")])
+  let root := start.getObjValAs? Nat "stateId" |>.toOption |>.getD 99999
+  discard <| execute (command "env.add" [("name", .str "Transaction.kept"),
+    ("type", .str "True"), ("value", .str "True.intro"), ("isTheorem", .bool false)])
+  discard <| execute (command "goal.print" [("stateId", toJson root)])
+  tests := tests ++ LSpec.test "goal printing preserves subsequent environment additions"
+    ((← getEnv).contains `Transaction.kept)
+  let entry ← get
+  let env ← getEnv
+  let coreEntry ← getThe Core.State
+  let mut limits := #[]
+  for phase in ["execute", "validate", "observe", "serialize"] do
+    let result ← runTransaction (command "goal.start") do
+      -- Stage changes to all retained allocations, options, and the environment.
+      modify fun s => { s with
+        nextId := 99999, goalStates := {},
+        options := { s.options with printExprAST := true } }
+      let added ← Pantograph.Environment.addDecl {
+        name := "Transaction.staged", type := "True", value := "True.intro", isTheorem := false }
+      unless added.toOption.isSome && (← getEnv).contains `Transaction.staged do
+        throwError "staged declaration was not installed"
+      modifyEnv fun env => env.setMainModule `MustBeDiscarded
+      modifyThe Core.State fun s => { s with nextMacroScope := 99999 }
+      logInfo "discarded command message"
+      withCommandPhase phase do
+        burn
+        return Json.null
+    let resource := result.response.getObjVal? "resource" |>.toOption |>.getD Json.null
+    limits := limits.push (resource.getObjValAs? Nat "limit" |>.toOption |>.getD 0)
+    tests := tests ++ LSpec.test s!"{phase} has a single recoverable resource envelope"
+      (!result.fatal && field result.response "error" == "resource" &&
+        field result.response "recovery" == "command-rolled-back" && field resource "phase" == phase &&
+        (Json.parse result.bytes).toOption == some result.response && !result.bytes.contains '\n' &&
+        (result.response.getObjVal? "stateId").toOption.isNone)
+    tests := tests ++ LSpec.test s!"{phase} discards all staged mutations"
+      ((← get).nextId == entry.nextId && (← get).goalStates.size == entry.goalStates.size &&
+        !(← get).options.printExprAST && (← getEnv).mainModule == env.mainModule &&
+        !(← getEnv).contains `Transaction.staged && (← getEnv).contains `Transaction.kept &&
+        (← getThe Core.State).nextMacroScope == coreEntry.nextMacroScope &&
+        (← getThe Core.State).messages.toArray.size == coreEntry.messages.toArray.size)
+  tests := tests ++ LSpec.test "reported limits use option units" (limits.all (· == 100))
+  let deletion ← runTransaction (command "goal.delete") do
+    modify fun s => { s with goalStates := s.goalStates.erase root }
+    withCommandPhase "serialize" do
+      burn
+      return Json.null
+  tests := tests ++ LSpec.test "deletion remains staged until complete response encoding"
+    (!deletion.fatal && (← get).goalStates.contains root)
+  let rendering ← executeCommand (command "goal.tactic"
+    [("stateId", toJson root), ("tactic", .str "contract_diagnostic_heartbeat")])
+  let resource := rendering.response.getObjVal? "resource" |>.toOption |>.getD Json.null
+  tests := tests ++ LSpec.test "lazy diagnostic exhaustion is observed without replaying messages"
+    (!rendering.fatal && field resource "phase" == "observe" && (← get).goalStates.size == 1)
+  let usageStart ← IO.getNumHeartbeats
+  for _ in [:3000] do
+    let result ← executeCommand (command "stat")
+    unless !result.fatal && (result.response.getObjValAs? Nat "nGoals").toOption == some 1 do
+      throwError "cheap command failed"
+  let used := (← IO.getNumHeartbeats) - usageStart
+  tests := tests ++ LSpec.test "combined cheap work exceeds one request budget" (used > 100000)
+  let timedOut ← executeCommand (command "goal.tactic" [("stateId", toJson root), ("tactic", .str "contract_heartbeat")])
+  tests := tests ++ LSpec.test "native tactic timeout reaches the shared classifier"
+    (field timedOut.response "error" == "resource" && !timedOut.fatal)
+  let solved ← execute (command "goal.tactic" [("stateId", toJson root), ("tactic", .str "exact True.intro")])
+  let done := solved.getObjValAs? Nat "nextStateId" |>.toOption |>.getD 99999
+  let certified ← execute (command "goal.certify" [("stateId", toJson done)])
+  tests := tests ++ LSpec.test "the original retained state supports a certified proof after timeout"
+    (field certified "status" == "certified")
+  let exhausted ← runTransaction (command "goal.certify") do
+    burn
+    return Json.null
+  tests := tests ++ LSpec.test "outer certification exhaustion is inconclusive without a receipt"
+    (field exhausted.response "status" == "inconclusive" && !exhausted.fatal &&
+      (exhausted.response.getObjVal? "receipt").toOption.isNone)
+  let fatal ← runTransaction (command "stat") do
+    throwError "unexpected failure"
+  let after ← executeCommand (command "stat")
+  tests := tests ++ LSpec.test "unexpected failure ends the session and rejects later dispatch"
+    (fatal.fatal && after.fatal && field fatal.response "error" == "internal" &&
+      field fatal.response "recovery" == "session-unusable")
+  return tests
+
+def suite (_ : Environment) : List (String × IO LSpec.TestSeq) := [
+  ("Command rollback and native budgets", do
+    let env ← importModules #[{ module := `Test.ContractFixtures }] {} (trustLevel := 1)
+    runCoreMSeq env (tests.run { imports := ["Test.ContractFixtures"] } |>.run' {}) #["maxHeartbeats=100"])
+]
+
+end Pantograph.Test.Transaction
diff --git a/Test/Validation.lean b/Test/Validation.lean
new file mode 100644
index 0000000..0734f60
--- /dev/null
+++ b/Test/Validation.lean
@@ -0,0 +1,156 @@
+import Test.Common
+import Test.ContractFixtures
+import Pantograph.Validation
+import Repl
+
+namespace Pantograph.Test.Validation
+open Lean Pantograph.Repl
+
+private def request (cmd : String) (fields : List (String × Json)) : MainM Json :=
+  Repl.execute { cmd, payload := Json.mkObj fields }
+
+private def start (expr : String) : MainM Nat := do
+  let result ← request "goal.start" [("expr", .str expr)]
+  match result.getObjValAs? Nat "stateId" with
+  | .ok id => pure id
+  | .error _ => throwError "goal.start failed: {result}"
+
+private def tactic (id : Nat) (text : String) (index : Nat := 0) : MainM Json :=
+  request "goal.tactic" [("stateId", toJson id), ("goalId", toJson index), ("tactic", .str text)]
+
+private def success (result : Json) : Bool :=
+  (result.getObjValAs? Nat "nextStateId").isOk &&
+  ((result.getObjVal? "validation").bind (·.getObjValAs? Bool "checked")).toOption == some true
+
+private def rejection (result : Json) : Bool :=
+  (result.getObjValAs? (Array String) "tacticErrors").isOk &&
+  !(result.getObjVal? "nextStateId").isOk &&
+  (result.getObjValAs? Bool "hasSorry").toOption == some false &&
+  (result.getObjValAs? Bool "hasUnsafe").toOption == some false
+
+private def goals (result : Json) : Array Json :=
+  result.getObjValAs? (Array Json) "goals" |>.toOption |>.getD #[]
+
+private def protocolTests : MainM LSpec.TestSeq := do
+  let mut tests := LSpec.TestSeq.done
+  let descriptor ← request "protocol.describe" []
+  tests := tests ++ LSpec.test "exact descriptor" (descriptor == toJson ({} : Protocol.ProtocolDescriptor))
+  let failedStart ← request "goal.start" [("expr", .str "(by run_tac Lean.logError \"start failure\"; exact True)")]
+  tests := tests ++ LSpec.test "logged start errors reject state allocation" ((failedStart.getObjValAs? String "error").toOption == some "elab")
+  tests := tests ++ LSpec.test "failed start allocated no state" ((← get).goalStates.isEmpty)
+  let root ← start "True"
+  let valid ← tactic root "trivial"
+  tests := tests ++ LSpec.test "valid completed transition" (success valid && (goals valid).isEmpty)
+  let skipped ← tactic root "skip"
+  tests := tests ++ LSpec.test "skip preserves the open goal" (success skipped && (goals skipped).size == 1)
+  let multiline ← start "∀ (p : Prop), p → p"
+  let result ← tactic multiline "intro p h\nexact h"
+  tests := tests ++ LSpec.test "complete multiline tactic sequence" (success result && (goals result).isEmpty)
+  let bad ← tactic root "trivial\nthis_is_not_a_tactic"
+  tests := tests ++ LSpec.test "trailing input rejected" ((bad.getObjValAs? String "parseError").isOk)
+  let bad ← tactic root "exact Nat.zero"
+  tests := tests ++ LSpec.test "ordinary type failure" (rejection bad)
+  let bad ← tactic root "run_tac Lean.logError \"capture error\" <;> trivial"
+  tests := tests ++ LSpec.test "logged error rejects completed tactic" (rejection bad)
+  let messages := bad.getObjValAs? (Array Protocol.Message) "messages" |>.toOption |>.getD #[]
+  tests := tests ++ LSpec.test "real error has source position" (messages.any fun m => m.pos.line == 1 && m.data == "capture error")
+  let bad ← tactic root "contract_failed_mutation"
+  tests := tests ++ LSpec.test "failed mutation rejected" (rejection bad)
+  let inspected ← request "env.inspect" [("name", .str "ContractFixtures.failedMutation")]
+  tests := tests ++ LSpec.test "failed environment mutation rolled back" ((inspected.getObjVal? "error").isOk)
+  let natRoot ← start "Nat"
+  discard <| tactic natRoot "contract_failed_mutation"
+  let reused ← tactic natRoot "contract_reuse_failed_name"
+  tests := tests ++ LSpec.test "failed declaration cache rolled back" (success reused && (goals reused).isEmpty)
+  let result ← tactic root "trivial"
+  tests := tests ++ LSpec.test "original state reusable after failures" (success result && (goals result).isEmpty)
+  let result ← tactic root "run_tac Lean.logWarning \"warning evidence\"\nrun_tac Lean.logInfo \"information evidence\"\ntrivial"
+  let messages := result.getObjValAs? (Array Protocol.Message) "messages" |>.toOption |>.getD #[]
+  tests := tests ++ LSpec.test "warning/information survive success" (success result &&
+    messages.any (fun m => m.severity == "warning" && m.data == "warning evidence") &&
+    messages.any (fun m => m.severity == "information" && m.data == "information evidence"))
+  let result ← tactic root "trivial"
+  tests := tests ++ LSpec.test "messages do not leak to following request" ((result.getObjValAs? (Array Protocol.Message) "messages").toOption == some #[])
+  for text in ["sorry", "exact (by sorry)", "have h : True := by sorry\nexact h", "contract_dependency_sorry"] do
+    let result ← tactic root text
+    tests := tests ++ LSpec.test s!"admission detected: {text}" (success result && (result.getObjValAs? Bool "hasSorry").toOption == some true)
+  let result ← tactic root "contract_unsafe"
+  tests := tests ++ LSpec.test "positive unsafe scanner evidence" (success result && (result.getObjValAs? Bool "hasUnsafe").toOption == some true)
+  let stored ← tactic root "contract_store_admission"
+  let storedId := stored.getObjValAs? Nat "nextStateId" |>.toOption |>.getD root
+  let used ← tactic storedId "exact ContractFixtures.storedAdmission"
+  tests := tests ++ LSpec.test "introduced declarations retain original trust boundary" (success used &&
+    (used.getObjValAs? Bool "hasSorry").toOption == some true)
+  let inspected ← request "env.inspect" [("name", .str "ContractFixtures.storedAdmission")]
+  tests := tests ++ LSpec.test "serialization does not leak successful environment mutations" ((inspected.getObjVal? "error").isOk)
+  let tagged ← tactic root "contract_tagged_warning"
+  let messages := tagged.getObjValAs? (Array Protocol.Message) "messages" |>.toOption |>.getD #[]
+  tests := tests ++ LSpec.test "message kind preserved" (messages.any fun m => m.kind == "ContractFixtures.warningKind")
+  let result ← tactic root "contract_hidden_hole"
+  tests := tests ++ LSpec.test "hidden reachable hole becomes a goal" (success result && (goals result).size == 1)
+  let id := result.getObjValAs? Nat "nextStateId" |>.toOption |>.getD root
+  let closed ← tactic id "trivial"
+  tests := tests ++ LSpec.test "restored hidden hole can be solved" (success closed && (goals closed).isEmpty)
+  let localHole ← tactic root "contract_hidden_local_value"
+  tests := tests ++ LSpec.test "hidden local value remains an obligation" (success localHole && (goals localHole).size == 1)
+  let delayed ← tactic root "contract_delayed_hole"
+  tests := tests ++ LSpec.test "delayed hole restored through the protocol" (success delayed && (goals delayed).size == 1)
+  let conjunction ← start "True ∧ True"
+  let split ← tactic conjunction "constructor"
+  let id := split.getObjValAs? Nat "nextStateId" |>.toOption |>.getD conjunction
+  let second ← tactic id "trivial" 1
+  tests := tests ++ LSpec.test "nonzero selection preserves sibling" (success second && (goals second).size == 1)
+  let ids := (← get).goalStates.toList.map (·.1)
+  discard <| request "goal.delete" [("stateIds", toJson ids)]
+  let count ← request "stat" []
+  tests := tests ++ LSpec.test "all test allocations deleted" ((count.getObjValAs? Nat "nGoals").toOption == some 0)
+  let validationRoot ← start "True"
+  let missing ← tactic validationRoot "contract_missing_assignment"
+  tests := tests ++ LSpec.test "missing assignment returns named validation error" ((missing.getObjValAs? String "error").toOption == some "validation" && !(missing.getObjVal? "nextStateId").isOk)
+  return tests
+
+private def boundaryTests : Elab.TermElabM LSpec.TestSeq := do
+  let mut tests := LSpec.TestSeq.done
+  let state ← GoalState.create (mkConst ``True)
+  let sibling ← Meta.mkFreshExprSyntheticOpaqueMVar (mkConst ``True)
+  let state ← GoalState.createFromMVars [state.root, sibling.mvarId!] state.root
+  let .success next ← state.tryTacticM state.root (do
+      let value ← Meta.mkSorry (mkConst ``True) false
+      sibling.mvarId!.assign value
+      Elab.Tactic.setGoals [state.root]) | throwError "coupled tactic failed"
+  let checked ← validateTransition state next state.root
+  tests := tests ++ LSpec.test "changed coupled assignment scanned" (checked.toOption.any (·.hasSorry))
+  let state ← GoalState.create (mkConst ``True)
+  let .success next ← state.tryTacticM state.root (do
+      let pending ← Meta.mkFreshExprSyntheticOpaqueMVar (mkConst ``True)
+      assignDelayedMVar state.root #[] pending.mvarId!
+      Elab.Tactic.setGoals []) | throwError "delayed tactic failed"
+  let checked ← validateTransition state next state.root
+  tests := tests ++ LSpec.test "delayed pending obligation retained" (checked.toOption.any fun result => result.state.goals.length == 1)
+  let missing : MVarId := ⟨`ContractFixtures.missing⟩
+  let corrupted := { state with savedState := { state.savedState with tactic := { goals := [missing] } } }
+  tests := tests ++ LSpec.test "missing evidence produces validation failure" (!(← validateTransition state corrupted state.root).isOk)
+  let cyclic := { state with savedState := { state.savedState with term := {
+    state.savedState.term with meta := { state.savedState.term.meta with meta := {
+      state.metaState with mctx := { state.mctx with eAssignment := state.mctx.eAssignment.insert state.root (.mvar state.root) }
+    } }
+  } } }
+  tests := tests ++ LSpec.test "cyclic assignments reject indeterminate evidence" (!(← validateTransition state cyclic state.root).isOk)
+  logInfo "outer log"
+  let outer := (← getThe Core.State).messages
+  let .failure _ _ ← state.tryTacticM state.root (do
+      (← Elab.Tactic.getMainGoal).assign (mkConst ``True.intro)
+      logError "inner failure") | throwError "shared operation accepted logged error"
+  let current := (← getThe Core.State).messages
+  tests := tests ++ LSpec.test "outer message log restored" (current.toArray.size == outer.toArray.size)
+  tests := tests ++ LSpec.test "failed assignment restored" (!(← getMCtx).eAssignment.contains state.root)
+  return tests
+
+def suite (env : Environment) : List (String × IO LSpec.TestSeq) := [
+  ("Transition boundary", runTermElabMSeq env boundaryTests),
+  ("Protocol diagnostics and checks", do
+    let env ← importModules #[{ module := `Test.ContractFixtures }] {} (trustLevel := 1)
+    runCoreMSeq env (protocolTests.run { imports := ["Test.ContractFixtures"] } |>.run' {}))
+]
+
+end Pantograph.Test.Validation
diff --git a/doc/compiler_aware_validation.md b/doc/compiler_aware_validation.md
new file mode 100644
index 0000000..2ea955a
--- /dev/null
+++ b/doc/compiler_aware_validation.md
@@ -0,0 +1,99 @@
+# Representation-aware environment audit, validation version 3
+
+Tactics that generate equations or match splitters compile them on demand. The
+pinned code generator then stores its intermediate stages in the retained
+environment as constants. Validation version 2 read every new constant with the
+kernel grammar, so the first compiler sentinel ended the session:
+
+```text
+execution owner=declaration _private.0.Nat.pow.match_1.splitter._rarg._cstage2
+path=environment audit/declaration-type/binder-type:
+Missing proof dependency _obj
+```
+
+`unfold Nat.pow`, `simp only [Nat.pow]` and `rw [Nat.pow]` reproduce it with only
+`Init` imported, in a fresh process and after earlier history
+([evidence](../pantograph_backport/compiler_aware_validation/README.md)).
+
+## Contract
+
+`protocol.describe` reports `transitionValidationVersion: 3`. Successful tactic
+responses include exactly:
+
+```json
+{"version":3,"scope":"execution-closure-and-representation-aware-audit","checked":true}
+```
+
+Protocol version 3, transition provenance, model expressions, inspection,
+certification, and transactional resources keep their versions. There is no
+version-2 fallback: the two versions audit different boundaries. A validation
+failure is still `error: "validation"`, allocates nothing, and ends the session.
+[The schema](scope_aware_validation.schema.json) and
+[fixtures](scope_aware_validation.fixtures.json) are the strict contract.
+
+## What the compiler stores
+
+Lean 4.10's code generator registers, for a compiled declaration `owner`:
+
+| Entry | Form | References |
+| --- | --- | --- |
+| `owner._cstage1` | unsafe definition, added without a kernel check | constants and IR declarations |
+| `owner._cstage2` | unsafe definition, no universe parameters | also `_obj`, `_neutral`, `_unreachable` |
+| `owner` IR, `owner._rarg`, `owner._boxed`, … | IR declarations in `declMapExt`; names without constants are in `extraConstNames` | — |
+
+The sentinel set and shapes come from every imported stage entry: 145,488 with
+`Init` and `Lean`, 461,882 with the pinned Mathlib. Stage-2 entries reference no
+other unresolved names and stage-1 entries none at all. No entry has
+metavariables or loose bound variables. Five Mathlib stage-1 entries contain
+free variables named `_kernel_fresh.N`, left by the code generator; they are
+imported, so the audit never reads them. A fresh entry of that form is still an
+integrity failure. That is deliberate and can be revisited if a compiler-producing
+tactic is found to emit one.
+
+## Classification
+
+The shared module `Pantograph/DeclarationAudit.lean` classifies each entry that
+is not in the trusted environment:
+
+- **Compiler representation**: a `_cstage1` or `_cstage2` name, an unsafe
+  definition, no universe parameters at stage 2, a stage-1 owner that is a
+  constant, and IR for the owner that the compiler registered in this
+  environment but not in the trusted one.
+- **Kernel declaration**: everything else, including an entry that is only
+  spelled like a stage. It keeps the strict execution audit, so an unregistered
+  `Fake._cstage2` that uses `_obj` still fails.
+
+Neither the spelling, `isUnsafe`, nor membership in the newly added map segment
+is a classifier on its own; the compiler's IR registration is the provenance.
+
+## Audits by role
+
+- A compiler representation found by the environment enumeration is audited as
+  compiler data: closed, and every reference resolves to a constant, an IR
+  declaration, or (stage 2) a sentinel. It does not set `hasUnsafe`: it is
+  runtime machinery, not a proof hazard. This checks the stored representation;
+  it does not verify generated code.
+- Any expression reference to a compiler representation is rejected:
+  `Compiler-only declaration … is not a proof dependency`. The check runs before
+  memoization, so an entry already audited as compiler data cannot satisfy a
+  later kernel reference.
+- Certification's dependency scan applies the same rule, and compiler entries
+  are never copied into the kernel environment that checks the root. Kernel
+  auxiliaries such as the splitter itself are reconstructed and checked as
+  before.
+
+Kernel declarations, retained locals, admissions, unsafe proof dependencies, new
+axioms, and the root-statement identity keep the version-2 checks. Polling,
+bounded diagnostics, cycle detection, and transactional rollback are unchanged.
+
+## Verification
+
+- `lake test`: 410 assertions, including `CompilerValidation` (compiler
+  transitions, continuation, inspection, certification, name-only and
+  malformed entries, compiler references from proofs and kernel declarations,
+  sentinels in kernel expressions, warmed history).
+- `lake env python3 scripts/test_scope_aware_validation.py`: core and pinned
+  Mathlib exchanges, including `unfold Nat.pow` → `split` → `rfl` → `rfl` with a
+  kernel receipt and `cases n <;> simp [Nat.pow]` under Mathlib.
+- `.lake/build/bin/compiler_diagnostic [--inventory] Init Lean`: the provenance
+  table and the sentinel inventory above.
